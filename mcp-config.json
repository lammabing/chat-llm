{
  "mcpServers": {
    "time-server": {
      "command": "node",
      "args": ["lib/mcp/examples/example-server.js"],
      "type": "stdio",
      "autoConnect": true
    },
 "youtube-caption-mcp": {
      "command": "npx",
      "args": ["-y", "youtube-caption-mcp", "--stdio"],
      "type" : "stdio",
      "env": {
        "CACHE_ENABLED": "true",
        "LOG_LEVEL": "debug"
      }
  },
  "mcpSettings": {
    "enableToolCalling": true,
    "logToolCalls": true,
    "allowedTools": [],
    "blockedTools": []
  }
}

}